# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_.

# Stripe publishable key (pk_test_... for sandbox). Public by design — it is
# embedded in the client bundle. Use the key from the SAME Stripe account as the
# backend's STRIPE_SECRET_KEY, or payment intents will not be found.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
